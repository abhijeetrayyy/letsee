# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Windows reserved device names (accidental redirects)
/nul
/con
/prn
/aux

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.commandcode/
/.next-build/

# Supabase CLI scratch state — machine-specific, and a future CLI version
# could write a connection string here.
supabase/.temp/

# Security audits. These enumerate findings that are not yet remediated, and
# this repository is public — a published audit is a published roadmap. Keep
# them local until everything they name is closed.
/docs/SYSTEM_AUDIT_*.md
